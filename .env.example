OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
RESEARCH_PROVIDER=offline
ALLOW_NETWORK=false
TRACE_INCLUDE_SENSITIVE_DATA=false
SUB_AGENT_TELEMETRY_ENABLED=true
SUB_AGENT_TELEMETRY_INCLUDE_CONTENT=true
SUB_AGENT_TELEMETRY_MAX_CHARS=30000
ARTIFACTS_DIR=artifacts
MAX_TURNS_PER_AGENT=6
REVISION_TIMEOUT_SECONDS=120
MAX_REWORK_PASSES=2
REWORK_TIMEOUT_SECONDS=120
MAX_SEARCHES=6
MAX_SOURCES=24
MAX_BRANCH_RETRIES=1
MAX_CONCURRENCY=6
TOTAL_TOKEN_BUDGET=60000
TOTAL_RESEARCH_TIME_SECONDS=300
MIN_SOURCE_DIVERSITY=3
MIN_PRIMARY_SOURCE_COVERAGE=0.80
# Optional current model rates used only for transparent approximate USD cost reporting.
OPENAI_INPUT_COST_PER_MILLION_USD=
OPENAI_CACHED_INPUT_COST_PER_MILLION_USD=
OPENAI_OUTPUT_COST_PER_MILLION_USD=
ENABLE_CLARIFICATION=true
ENABLE_MANAGER_RECONCILIATION=true
ENABLE_ADVERSARIAL_REVIEW=true
# Optional JSON list, e.g. ["global_research"]
DISABLED_BRANCHES=[]
